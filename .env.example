# ==============================================================================
# HIPA Masala Website Environment Variables (Zero-Database Architecture)
# ==============================================================================

# 1. Admin Authentication Settings
# Required for accessing the /admin panel.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=choose-a-strong-password

# 2. Google Sheets Integration (For Contact Forms & Newsletters)
# Follow instructions in scripts/google-sheets-script.js to create your free Web App URL
GOOGLE_SHEETS_ENQUIRIES_URL=
GOOGLE_SHEETS_NEWSLETTER_URL=

# 3. Canonical Website URL
CANONICAL_ORIGIN=https://www.hipamasalas.com

# 4. Google Gemini API Key (Server-Side Only - 100% Free Tier for Customer Chatbot)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
