# Add these values in Vercel → Project → Settings → Environment Variables.
# Never commit real credentials into source control.
NODE_ENV=production
CANONICAL_ORIGIN=https://www.hipamasalas.com
SITE_NAME=HIPA Masalas

# Create a long random secret for signed private-admin sessions.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN_USERNAME=replace-with-private-admin-username
ADMIN_LOGIN_PASSWORD=replace-with-private-admin-password

# Google Sheets Webhook for Enquiries and Newsletters (Free & Zero-Database)
# Created via Google Apps Script (instructions in scripts/google-sheets-script.js)
GOOGLE_SHEETS_ENQUIRIES_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEETS_NEWSLETTER_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Google Gemini API Key for Customer Assistant Chatbot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
