# Add these values in Vercel → Project → Settings → Environment Variables.
# Never commit real credentials into source control.
NODE_ENV=production
CANONICAL_ORIGIN=https://www.hipamasalas.com
SITE_NAME=HIPA Masalas

# Create a long random secret for signed private-admin sessions.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN_USERNAME=replace-with-private-admin-username
ADMIN_LOGIN_PASSWORD=replace-with-private-admin-password

# Required for persistent enquiries, newsletter subscriptions, product availability and blog admin updates.
# Use a MySQL-compatible managed database connection string with SSL enabled.
DATABASE_URL=mysql://user:password@host:3306/database?ssl={"rejectUnauthorized":true}
